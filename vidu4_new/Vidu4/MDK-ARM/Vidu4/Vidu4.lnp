--cpu=Cortex-M4.fp.sp
"vidu4\startup_stm32f411xe.o"
"vidu4\main.o"
"vidu4\stm32f4xx_it.o"
"vidu4\stm32f4xx_hal_msp.o"
"vidu4\stm32f4xx_hal_tim.o"
"vidu4\stm32f4xx_hal_tim_ex.o"
"vidu4\stm32f4xx_hal_rcc.o"
"vidu4\stm32f4xx_hal_rcc_ex.o"
"vidu4\stm32f4xx_hal_flash.o"
"vidu4\stm32f4xx_hal_flash_ex.o"
"vidu4\stm32f4xx_hal_flash_ramfunc.o"
"vidu4\stm32f4xx_hal_gpio.o"
"vidu4\stm32f4xx_hal_dma_ex.o"
"vidu4\stm32f4xx_hal_dma.o"
"vidu4\stm32f4xx_hal_pwr.o"
"vidu4\stm32f4xx_hal_pwr_ex.o"
"vidu4\stm32f4xx_hal_cortex.o"
