--cpu=Cortex-M4.fp.sp
"vidu2_rx\startup_stm32f411xe.o"
"vidu2_rx\main.o"
"vidu2_rx\stm32f4xx_it.o"
"vidu2_rx\stm32f4xx_hal_msp.o"
"vidu2_rx\stm32f4xx_hal_uart.o"
"vidu2_rx\stm32f4xx_hal_rcc.o"
"vidu2_rx\stm32f4xx_hal_rcc_ex.o"
"vidu2_rx\stm32f4xx_hal_flash.o"
"vidu2_rx\stm32f4xx_hal_flash_ex.o"
"vidu2_rx\stm32f4xx_hal_flash_ramfunc.o"
"vidu2_rx\stm32f4xx_hal_gpio.o"
"vidu2_rx\stm32f4xx_hal_dma_ex.o"
"vidu2_rx\stm32f4xx_hal_dma.o"
"vidu2_rx\stm32f4xx_hal_pwr.o"
"vidu2_rx\stm32f4xx_hal_pwr_ex.o"
"vidu2_rx\stm32f4xx_hal_cortex.o"
"vidu2_rx\stm32f4xx_hal.o"
"vidu2_rx\stm32f4xx_hal_exti.o"
"vidu2_rx\system_stm32f4xx.o"
--strict --scatter "vidu2_Rx\vidu2_Rx.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "vidu2_Rx.map" -o vidu2_Rx\vidu2_Rx.axf